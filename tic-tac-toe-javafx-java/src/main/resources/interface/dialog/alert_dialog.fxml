<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:id="alertPane" cache="true"
            cacheHint="SPEED" focusTraversable="true" styleClass="pane"
            stylesheets="@../../assist/css/interface/dialog/alert-dialog.css">
    <top>
        <Label alignment="TOP_LEFT" styleClass="title" text="%control.label.alert"/>
    </top>
    <center>
        <Label fx:id="alertBody" alignment="CENTER" maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308" styleClass="body" text="Initial text" textAlignment="CENTER">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
            <BorderPane.margin>
                <Insets top="5" bottom="5"/>
            </BorderPane.margin>
        </Label>
    </center>
    <bottom>
        <JFXButton onAction="#onButtonClick" prefWidth="50.0" styleClass="button" text="%control.button.ok"
                   BorderPane.alignment="CENTER_RIGHT"/>
    </bottom>
</BorderPane>
