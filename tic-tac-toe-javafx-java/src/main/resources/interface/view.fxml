<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.*?>
<StackPane fx:id="viewPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
           prefHeight="400.0" prefWidth="600.0" styleClass="pane" stylesheets="@../assist/css/interface/view.css"
           xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.mj.tic.tac.toe.javafx.java.controller.view.ViewController">
    <BorderPane prefHeight="200.0" prefWidth="200.0">
        <top>
            <fx:include fx:id="applicationBar" source="../interface/layout/application_bar.fxml"/>
        </top>
        <center>
            <StackPane fx:id="contentPane" prefHeight="150.0" prefWidth="200.0" styleClass="content-pane"
                       BorderPane.alignment="CENTER">
                <BorderPane prefHeight="200.0" prefWidth="200.0">
                    <left>
                        <BorderPane prefWidth="180.0" styleClass="left-panel" BorderPane.alignment="CENTER">
                            <BorderPane.margin>
                                <Insets right="5"/>
                            </BorderPane.margin>
                            <top>
                                <GridPane styleClass="header" BorderPane.alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>
                                    <JFXButton maxWidth="1.7976931348623157E308" styleClass="reset"
                                               onMouseClicked="#onResetGame" text="%control.button.reset"/>
                                    <JFXButton maxWidth="1.7976931348623157E308" styleClass="play"
                                               onMouseClicked="#onPlayGame" text="%control.button.play"
                                               GridPane.columnIndex="1"/>
                                </GridPane>
                            </top>
                            <center>
                                <ListView fx:id="wins" prefHeight="200.0" prefWidth="200.0" styleClass="body"
                                          BorderPane.alignment="CENTER">
                                    <BorderPane.margin>
                                        <Insets bottom="3" top="3"/>
                                    </BorderPane.margin>
                                </ListView>
                            </center>
                            <bottom>
                                <GridPane styleClass="footer" BorderPane.alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="0.0"
                                                           prefWidth="50.0"/>
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                    </rowConstraints>
                                    <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                           text="%control.label.wins.x" GridPane.rowIndex="1"/>
                                    <Label fx:id="totalXWins" alignment="CENTER" maxHeight="1.7976931348623157E308"
                                           maxWidth="1.7976931348623157E308" text="0" GridPane.columnIndex="1"
                                           GridPane.rowIndex="1"/>
                                    <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                           text="%control.label.wins.o" GridPane.rowIndex="2"/>
                                    <Label fx:id="totalOWins" alignment="CENTER" maxHeight="1.7976931348623157E308"
                                           maxWidth="1.7976931348623157E308" text="0" GridPane.columnIndex="1"
                                           GridPane.rowIndex="2"/>
                                    <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                                           text="%control.label.draw"/>
                                    <Label fx:id="totalDraw" alignment="CENTER" maxHeight="1.7976931348623157E308"
                                           maxWidth="1.7976931348623157E308" text="0" GridPane.columnIndex="1"/>
                                </GridPane>
                            </bottom>
                        </BorderPane>
                    </left>
                    <center>
                        <GridPane fx:id="playAreaPane" styleClass="center-panel" BorderPane.alignment="CENTER"
                                  disable="true">
                            <BorderPane.margin>
                                <Insets left="5"/>
                            </BorderPane.margin>
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
                            </rowConstraints>
                            <JFXButton mnemonicParsing="false" styleClass="top-left" GridPane.rowIndex="0"
                                       GridPane.columnIndex="0"/>
                            <JFXButton mnemonicParsing="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <JFXButton mnemonicParsing="false" styleClass="top-right" GridPane.rowIndex="0"
                                       GridPane.columnIndex="2"/>
                            <JFXButton mnemonicParsing="false" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <JFXButton mnemonicParsing="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <JFXButton mnemonicParsing="false" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            <JFXButton mnemonicParsing="false" styleClass="bottom-left" GridPane.rowIndex="2"
                                       GridPane.columnIndex="0"/>
                            <JFXButton mnemonicParsing="false" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <JFXButton mnemonicParsing="false" styleClass="bottom-right" GridPane.rowIndex="2"
                                       GridPane.columnIndex="2"/>
                        </GridPane>
                    </center>
                </BorderPane>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
