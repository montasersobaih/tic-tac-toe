<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:id="confirmPane"
            cache="true" cacheHint="SPEED" focusTraversable="true" styleClass="pane"
            stylesheets="@../../assist/css/interface/dialog/alert-dialog.css">
    <top>
        <Label fx:id="confirmTitle" alignment="TOP_LEFT" styleClass="title" text="%control.label.alert"/>
    </top>
    <center>
        <Label fx:id="confirmBody" alignment="BASELINE_CENTER" maxHeight="1.7976931348623157E308"
               maxWidth="1.7976931348623157E308" styleClass="body" text="Initial text" textAlignment="CENTER"
               wrapText="true">
            <font>
                <Font name="System Bold" size="13.0"/>
            </font>
            <BorderPane.margin>
                <Insets bottom="5.0" top="5.0"/>
            </BorderPane.margin>
        </Label>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT">
            <JFXButton onAction="#onDeclineButton" text="%control.button.cancel"/>
            <JFXButton onAction="#onConfirmButton" text="%control.button.play"/>
        </HBox>
    </bottom>
</BorderPane>
